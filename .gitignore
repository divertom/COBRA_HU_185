# ESP-IDF Build files
build/
*.bin
*.elf
*.map

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ESP-IDF specific
sdkconfig.old
sdkconfig.defaults.old

# Tooling caches (not portable)
.cache/

# IDE (keep shared .vscode: ESP-IDF / CMake; ignore personal add-ons)
.vscode/*.local.json
.idea/
*.code-workspace
.clangd

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Dependencies lock (regenerated per machine; local paths are not portable)
dependencies.lock

# Preview tooling (npm deps when running lv_font_conv via npx locally)
tools/node_modules/

# Temporary files
*.tmp
*.log
*.bak

# Local device secrets (copy from storage/config/device_config.json.example)
storage/config/device_config.json

# Raster builds — keep sources under artwork/ only; never commit misplaced bins next to PNGs there.
artwork/**/*.bin

# Optimized image files (can be regenerated)
storage/images/*.raw
# Generated header files (hard-coded images - not used, use SPIFFS instead)
main/**/*_logo.h
main/**/*_image.h
main/**/*_bitmap.h

